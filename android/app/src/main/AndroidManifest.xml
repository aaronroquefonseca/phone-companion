<?xml version="1.0" encoding="utf-8"?>
<!-- P0 BASE skeleton manifest: permissions + component declarations only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backend reachability for enroll/poll. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Targeted notifications: requested only after a successful pairing
        (see MainActivity), never on the unpaired launcher. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- No CAMERA permission: pairing scans with the Play services code
        scanner (GmsBarcodeScanning), which runs Google's own scanner
        activity and needs no app-side camera permission or boilerplate. -->
    <!-- Install gate for remote APK pushes (app_install): the pre-install
        UI checks packageManager.canRequestPackageInstalls() and routes to
        Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES first; install is never
        attempted without the grant. PackageInstaller sessions need this to
        commit. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- No RECEIVE_BOOT_COMPLETED: WorkManager persists the hourly poll
        across reboots on its own; no boot receiver is promised or needed. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PhoneCompanion"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PairActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WidgetsActivity"
            android:exported="false" />
        <!-- Widget configuration: placement (android:configure on the
             provider) and re-configure (unassociated-tap + Widgets-screen
             instance buttons via editIntent). Exported: the launcher starts
             the placement flow cross-uid. Writes only the caller's own
             binding row (widget_binding PK) and pushes that instance. -->
        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="true" />
        <!-- Transparent tap router for Glance widgets (paired → Widgets,
             unpaired → Pair). Exported=false: explicit in-app intents only. -->
        <activity
            android:name=".ui.WidgetTapRouterActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneCompanion.TapRouter" />

        <!-- Push receiver (P9: per-kind channels, up to 3 action buttons,
             BigPictureStyle image attachments, extensible kinds registry). -->
        <service
            android:name=".notify.CompanionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Remote APK install (app_install push): the transfer starts on
            command receipt (poll or FCM wake), never here. This pre-install
            UI is optional detail opened ONLY by an explicit tap (progress /
            grant notification, foreground dialog) — never auto-started, no
            boot receiver. Exported=false: explicit in-app PendingIntents
            only. -->
        <activity
            android:name=".ui.AppInstallActivity"
            android:exported="false" />

        <!-- PackageInstaller result + download-cancel receivers for the
            install flow. Exported=false: explicit PendingIntents from this
            app only (installer status, notification Cancel action). -->
        <receiver
            android:name=".notify.AppInstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.AppInstallCancelReceiver"
            android:exported="false" />

        <!-- Shizuku binder entry (silent installs): mandatory — without
             this provider the Shizuku binder is never delivered and every
             install stays on the dialog path. The manager app itself is a
             separate user install (never bundled). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- FileProvider for the ACTION_VIEW commit-failure fallback: serves
             the verified cached APK to the system installer ONLY from the
             app_push cache dir (see res/xml/app_install_filepaths.xml —
             never the whole cache, never external dirs). Exported=false:
             cross-uid access flows through the per-intent read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/app_install_filepaths" />
        </provider>

        <!-- Single Glance widget receiver. One picker entry ("Widget");
              placement and tap-to-configure choose any cached row. -->
        <receiver
            android:name=".widgets.CompanionWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- Foreground host for wake-triggered install work: keeps the
             process alive through download + commit so the terminal
             notification always posts. Started only from a high-priority
             FCM wake (the platform's allowed background-FGS exemption). -->
        <!-- Instant mode: holds the backend long-poll so commands arrive
             immediately regardless of Doze/FCM batching. Opt-in. -->
        <!-- Restarts instant mode after reboot or app update. -->
        <receiver
            android:name=".notify.InstantModeBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".notify.InstantModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".notify.WakeInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
