<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/skeletonNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/skeleton_notice"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/pairStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/main_not_paired"
        app:layout_constraintTop_toBottomOf="@id/skeletonNotice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/pairButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pair"
        app:layout_constraintTop_toBottomOf="@id/pairStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/widgetsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Widgets"
        app:layout_constraintTop_toBottomOf="@id/pairButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
