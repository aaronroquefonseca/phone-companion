<?xml version="1.0" encoding="utf-8"?>
<!-- List widget: tall card for checklist rows with a "+N more" overflow hint.
     Tap opens the app (tap router: Widgets screen when paired, Pair when
     unpaired). A per-instance configuration activity (picking a specific row
     per widget) is out of scope at v1 — each slot shows the cached row
     matching its position among the bound widgets of its type. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/preview_list_widget"
    android:label="@string/widget_list_label"
    android:description="@string/widget_list_desc" />
<!-- updatePeriodMillis=0: the app drives refresh via WorkManager. -->
