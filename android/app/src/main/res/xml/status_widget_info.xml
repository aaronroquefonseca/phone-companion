<?xml version="1.0" encoding="utf-8"?>
<!-- Status widget: single-row state badge + detail. Tap opens the app (tap
     router: Widgets screen when paired, Pair when unpaired). A per-instance
     configuration activity (picking a specific row per widget) is out of
     scope at v1 — each slot shows the cached row matching its position among
     the bound widgets of its type. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/preview_status_widget"
    android:label="@string/widget_status_label"
    android:description="@string/widget_status_desc" />
<!-- updatePeriodMillis=0: the app drives refresh via WorkManager. -->
