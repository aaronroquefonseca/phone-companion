<?xml version="1.0" encoding="utf-8"?>
<!-- Status widget: single-row state badge + detail. Tap opens the app
      (bound: tap router; unassociated: the configuration activity to pick a
      row). Placing the widget opens the configuration (android:configure):
      pick a cached status row or leave it unassociated, then tap the widget
      to change it. Clearing the pick (or a server-removed row) shows
      "Not associated". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.phonecompanion.app.ui.WidgetConfigActivity"
    android:label="@string/widget_status_label"
    android:description="@string/widget_status_desc" />
<!-- updatePeriodMillis=0: the app drives refresh via WorkManager. -->
