<?xml version="1.0" encoding="utf-8"?>
<!-- Secret widget: compact card for one secured value (masked until the next
      poll decrypts it). Tap opens the app (bound: tap router; unassociated:
      the configuration activity to pick a row — still masked, no oracle).
      Placing the widget opens the configuration (android:configure): pick a
      cached secret row or leave it unassociated, then tap the widget to
      change it. Clearing the pick (or a server-removed row) shows the masked
      unassociated state. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.phonecompanion.app.ui.WidgetConfigActivity"
    android:label="@string/widget_secret_label"
    android:description="@string/widget_secret_desc" />
<!-- updatePeriodMillis=0: the app drives refresh via WorkManager. -->
